# --- Ren'Py Compiled Files ---
# These are generated by Ren'Py on launch and are generally not needed in Git.
*.rpyc
*.rpymc
*.rpyb
*.save

# --- Ren'Py Generated / Temporary Files ---
# Temporary backups and output logs.
*.bak
*.new
*.old
errors.txt
log.txt
traceback.txt
image_cache.txt
save_dump.txt

# --- Directories ---
# Ignore personal save files and engine cache.
game/saves/
game/cache/
/tmp/

# --- System & Editor Files ---
# OS-specific and IDE-generated files.
.DS_Store
Thumbs.db
__pycache__/
*.py[cod]
.vscode/
.idea/
